{
  "expo": {
    "name": "PetAdopt",
    "slug": "ivanp2003-examen1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "petadopt",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF7ED"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.petadopt.app",
      "newArchEnabled": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFF7ED"
      },
      "package": "com.ivanp2003.petadopt",
      "newArchEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": {
            "scheme": "petadopt"
          }
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite que PetAdopt acceda a tu ubicación para mostrarte los refugios cercanos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite que PetAdopt acceda a tu galería para subir la foto de la mascota."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3f11369f-a7f8-4d98-80e2-1b70fc00be7f"
      }
    },
    "owner": "iandres",
    "updates": {
      "checkAutomatically": "NEVER"
    }
  }
}
